# DeepSeek Configuration (Primary — Low Cost)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Independent judge (recommended). Any OpenAI-compatible endpoint.
# If JUDGE_MODEL is empty, the agent model grades itself and each eval run
# records that as "self-graded".
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=

# Optional Fallback Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=harness-ops
